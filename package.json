{
    "private": true,
    "type": "module",
    "scripts": {
        "dev:styles": "postcss resources/css/plugin.css -o resources/dist/filament-tree.css --watch",
        "dev:scripts": "node bin/build.js --dev",
        "build:styles": "NODE_ENV=production postcss resources/css/plugin.css -o resources/dist/filament-tree.css && cp resources/dist/filament-tree.css resources/dist/filament-tree-min.css",
        "build:scripts": "node bin/build.js",
        "purge": "filament-purge -i resources/dist/filament-tree.css -o resources/dist/filament-tree.css",
        "dev": "npm-run-all --parallel dev:*",
        "build": "npm-run-all build:*"
    },
    "devDependencies": {
        "@awcodes/filament-plugin-purge": "^1.1.1",
        "@tailwindcss/forms": "^0.5.4",
        "@tailwindcss/postcss": "^4.1.10",
        "@tailwindcss/typography": "^0.5.9",
        "autoprefixer": "^10.5.4",
        "cssnano": "^8.0.2",
        "esbuild": "^0.19.12",
        "lightningcss-wasm": "^1.33.0",
        "npm-run-all": "^4.1.5",
        "postcss": "^8.4.26",
        "postcss-cli": "^11.0.1",
        "postcss-import": "^16.1.1",
        "prettier": "^2.7.1",
        "prettier-plugin-tailwindcss": "^0.1.13",
        "tailwindcss": "^3.4.19"
    },
    "dependencies": {
        "sortablejs": "^1.15.0"
    },
    "allowScripts": {}
}
